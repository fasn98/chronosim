# Builds the PDF with the official ReScience C template, pinned to one commit.
# The template files (GPL-3+; fonts under OFL) are fetched into this directory
# and are not committed: see .gitignore and README.md.
TEMPLATE_URL    = https://github.com/ReScience/template.git
TEMPLATE_COMMIT = 0978d0e5d9a86246789fd3468aec6fc71e39c944
TEMPLATE_FILES  = rescience.cls header.tex yaml-to-latex.py article.py roboto source-serif-pro source-sans-pro source-code-pro

.PHONY: all template clean preprint arxiv
all: article.pdf

.template:
	git clone -q $(TEMPLATE_URL) .template
	git -C .template checkout -q $(TEMPLATE_COMMIT)

template: .template
	cp -r $(addprefix .template/,$(TEMPLATE_FILES)) .

metadata.tex: metadata.yaml | template
	LC_ALL=en_US.UTF-8 python3 ./yaml-to-latex.py -i $< -o $@

article.pdf: article.tex content.tex bibliography.bib metadata.tex $(wildcard generated/*.tex) | template
	latexmk -g -pdf -pdflatex="xelatex -interaction=nonstopmode -halt-on-error" article.tex

# Neutral preprint (article class, pdflatex + BibTeX): same content.tex, numbers and bibliography.
# The abstract is taken from metadata.yaml, so it is not copied by hand.
generated/abstract.tex: metadata.yaml
	python3 -c "import yaml; a = yaml.safe_load(open('metadata.yaml', encoding='utf-8'))['abstract'].strip(); open('$@', 'w', encoding='utf-8').write('% Generated by paper/Makefile from metadata.yaml (abstract).\\n\\\\newcommand{\\\\PreprintAbstract}{' + a + '}\\n')"

preprint: preprint.pdf
preprint.pdf: preprint.tex content.tex bibliography.bib generated/abstract.tex $(wildcard generated/*.tex)
	pdflatex -interaction=nonstopmode -halt-on-error preprint.tex >/dev/null
	bibtex preprint
	pdflatex -interaction=nonstopmode -halt-on-error preprint.tex >/dev/null
	pdflatex -interaction=nonstopmode -halt-on-error preprint.tex

# arXiv archive: preprint.tex, content.tex, generated/*.tex, the .bbl and the figures used, in
# figures/ (content.tex reads ../outputs/, which arXiv cannot provide; preprint.tex falls back).
ARXIV_FIGS = $(shell grep -o '\.\./outputs/[^}]*' content.tex | sed 's|\.\./outputs/||' | sort -u)
arxiv: arxiv.tar.gz
arxiv.tar.gz: preprint.pdf
	rm -rf .arxiv && mkdir -p .arxiv/generated .arxiv/figures
	cp preprint.tex content.tex preprint.bbl .arxiv/
	cp generated/*.tex .arxiv/generated/
	cp $(addprefix ../outputs/,$(ARXIV_FIGS)) .arxiv/figures/
	tar -C .arxiv -czf $@ .
	rm -rf .arxiv

clean:
	rm -f preprint.pdf preprint.aux preprint.log preprint.out preprint.bbl preprint.blg arxiv.tar.gz
	-latexmk -CA
	rm -rf .template metadata.tex *.bbl *.run.xml $(TEMPLATE_FILES)
